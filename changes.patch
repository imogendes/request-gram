diff --git a/submodules/WalletContext/Tests/WalletGramRequestTests.swift b/submodules/WalletContext/Tests/WalletGramRequestTests.swift
new file mode 100644
index 000000000..f5e7b98a5
--- /dev/null
+++ b/submodules/WalletContext/Tests/WalletGramRequestTests.swift
@@ -0,0 +1,147 @@
+import XCTest
+import TelegramCore
+@testable import WalletContext
+
+/// The Request GRAM decisions the screens make without strings: which server reason becomes which notice
+/// (and whether it blocks the Request button), what the client mirrors before asking, the payer's warnings,
+/// and the check that refuses to pay a request whose destination does not match the server's record.
+final class WalletGramRequestTests: XCTestCase {
+    // MARK: - Eligibility reason -> notice
+
+    func test_everyReason_mapsToItsNotice() {
+        let expected: [(GramRequestIneligibilityReason, WalletGramRequestNotice.Kind, Bool)] = [
+            (.featureDisabled, .disabled, true),
+            (.usernameRequired, .usernameRequired, true),
+            (.accountTooNew, .accountTooNew, true),
+            (.dailyLimit, .dailyLimit, true),
+            (.pendingRequestExists, .pendingRequestExists, true),
+            (.privacy, .privacy, true),
+            (.noConversation, .noConversation, true),
+            (.paidMessages, .paidMessages, true),
+            (.restricted, .restricted, true),
+            (.amountInvalid, .amountInvalid, false),
+            (.other("GRAM_REQUEST_SOMETHING_NEW"), .generic, false)
+        ]
+        for (reason, kind, blocks) in expected {
+            let notice = WalletGramRequestNotice(reason: reason)
+            XCTAssertEqual(notice.kind, kind, "\(reason)")
+            XCTAssertEqual(notice.blocksRequest, blocks, "\(reason)")
+        }
+    }
+
+    func test_onlyUsernameRequired_offersSetUsername() {
+        XCTAssertTrue(WalletGramRequestNotice(reason: .usernameRequired).offersSetUsername)
+        for reason in [GramRequestIneligibilityReason.featureDisabled, .accountTooNew, .dailyLimit, .pendingRequestExists, .privacy, .noConversation, .paidMessages, .restricted, .amountInvalid, .other("")] {
+            XCTAssertFalse(WalletGramRequestNotice(reason: reason).offersSetUsername, "\(reason)")
+        }
+    }
+
+    func test_peerNamingNotices() {
+        XCTAssertTrue(WalletGramRequestNotice(reason: .privacy).namesPeer)
+        XCTAssertTrue(WalletGramRequestNotice(reason: .paidMessages).namesPeer)
+        XCTAssertTrue(WalletGramRequestNotice(reason: .pendingRequestExists).namesPeer)
+        XCTAssertFalse(WalletGramRequestNotice(reason: .dailyLimit).namesPeer)
+    }
+
+    func test_requestErrors_mapToNotices() {
+        XCTAssertEqual(WalletGramRequestNotice(error: .ineligible(.dailyLimit)), WalletGramRequestNotice(reason: .dailyLimit))
+        for error in [GramRequestError.network, .generic, .notFound, .notPending, .expired] {
+            let notice = WalletGramRequestNotice(error: error)
+            XCTAssertEqual(notice.kind, .generic, "\(error)")
+            XCTAssertFalse(notice.blocksRequest, "a transient failure must leave the button usable")
+        }
+    }
+
+    // MARK: - Client mirror
+
+    private let clean = WalletGramRequestClientState(accountHasUsername: true, accountIsScamOrFake: false, peerIsScamOrFake: false, peerChargesForMessages: false)
+
+    func test_clientState_refusals() {
+        XCTAssertNil(self.clean.refusal)
+
+        var state = self.clean
+        state.accountHasUsername = false
+        XCTAssertEqual(state.refusal, .usernameRequired)
+
+        state = self.clean
+        state.peerChargesForMessages = true
+        XCTAssertEqual(state.refusal, .paidMessages)
+
+        state = self.clean
+        state.peerIsScamOrFake = true
+        XCTAssertEqual(state.refusal, .restricted)
+
+        state.accountHasUsername = false
+        XCTAssertEqual(state.refusal, .restricted, "a scam or fake account is refused before anything else is explained")
+    }
+
+    func test_notice_prefersClientRefusalThenServerAnswer() {
+        var noUsername = self.clean
+        noUsername.accountHasUsername = false
+        let allowed = GramRequestEligibility(isAllowed: true, reason: nil, remainingToday: 4)
+        let refused = GramRequestEligibility(isAllowed: false, reason: .privacy, remainingToday: 4)
+
+        XCTAssertEqual(walletGramRequestNotice(clientState: noUsername, eligibility: allowed)?.kind, .usernameRequired)
+        XCTAssertEqual(walletGramRequestNotice(clientState: self.clean, eligibility: refused)?.kind, .privacy)
+        XCTAssertNil(walletGramRequestNotice(clientState: self.clean, eligibility: allowed))
+        XCTAssertNil(walletGramRequestNotice(clientState: self.clean, eligibility: nil), "an unknown answer leaves the decision to the server")
+        XCTAssertEqual(walletGramRequestNotice(clientState: self.clean, eligibility: GramRequestEligibility(isAllowed: false, reason: nil, remainingToday: 0))?.kind, .generic)
+    }
+
+    func test_offeredOnlyForRegularUsersWhileEnabled() {
+        XCTAssertTrue(walletGramRequestIsOffered(isEnabled: true, peerIsRegularUser: true, peerIsAccount: false))
+        XCTAssertFalse(walletGramRequestIsOffered(isEnabled: false, peerIsRegularUser: true, peerIsAccount: false))
+        XCTAssertFalse(walletGramRequestIsOffered(isEnabled: true, peerIsRegularUser: false, peerIsAccount: false))
+        XCTAssertFalse(walletGramRequestIsOffered(isEnabled: true, peerIsRegularUser: true, peerIsAccount: true))
+    }
+
+    // MARK: - Payer warnings
+
+    private func record(status: TelegramGramRequestStatus = .pending, address: String = "addr-a", usernameRecentlyChanged: Bool = false, noOutgoingMessages: Bool = false) -> GramRequestRecord {
+        return GramRequestRecord(requestId: 77, amount: 250, requesterAddress: address, expiresAt: 2_000, status: status, comment: nil, usernameRecentlyChanged: usernameRecentlyChanged, noOutgoingMessages: noOutgoingMessages)
+    }
+
+    func test_warnings() {
+        XCTAssertEqual(walletGramRequestWarnings(record: self.record(), requesterIsContact: true), [])
+        XCTAssertEqual(walletGramRequestWarnings(record: self.record(usernameRecentlyChanged: true, noOutgoingMessages: true), requesterIsContact: false), [.usernameRecentlyChanged, .noOutgoingMessages, .notContact])
+        XCTAssertEqual(walletGramRequestWarnings(record: nil, requesterIsContact: false), [.notContact])
+    }
+
+    // MARK: - Payment check
+
+    private func check(_ record: GramRequestRecord, messageAddress: String = "addr-a", walletAddresses: [String] = ["addr-a"], timestamp: Int32 = 1_000, requestId: Int64 = 77, amount: Int64 = 250) -> WalletGramRequestPaymentCheck {
+        return walletGramRequestPaymentCheck(record: record, messageRequestId: requestId, messageAmount: amount, messageRequesterAddress: messageAddress, requesterWalletAddresses: walletAddresses, timestamp: timestamp, addressesEqual: { $0 == $1 })
+    }
+
+    func test_paymentCheck_payableWhenEverythingMatches() {
+        XCTAssertEqual(self.check(self.record()), .payable)
+    }
+
+    func test_paymentCheck_refusesTerminalOrExpiredRequests() {
+        XCTAssertEqual(self.check(self.record(status: .paid(transactionId: "t", paidAt: 1))), .notPayable)
+        XCTAssertEqual(self.check(self.record(status: .declined)), .notPayable)
+        XCTAssertEqual(self.check(self.record(status: .cancelled)), .notPayable)
+        XCTAssertEqual(self.check(self.record(), timestamp: 2_000), .notPayable, "past the record's expiry")
+    }
+
+    func test_paymentCheck_refusesAddressOrAmountMismatch() {
+        XCTAssertEqual(self.check(self.record(), messageAddress: "addr-b"), .addressMismatch, "the message shows another address")
+        XCTAssertEqual(self.check(self.record(), walletAddresses: ["addr-b"]), .addressMismatch, "the record is not the requester's wallet")
+        XCTAssertEqual(self.check(self.record(), walletAddresses: []), .addressMismatch, "no known wallet for the requester")
+        XCTAssertEqual(self.check(self.record(), amount: 251), .addressMismatch)
+        XCTAssertEqual(self.check(self.record(), requestId: 78), .addressMismatch)
+    }
+
+    // MARK: - Request flight id
+
+    func test_requestFlightId_roundTrips() {
+        let messageId = EngineMessage.Id(peerId: EnginePeer.Id(1_234_567), namespace: Namespaces.Message.Cloud, id: 4512)
+        XCTAssertEqual(walletGramRequestFlightMessageId(walletGramRequestFlightId(messageId)), messageId)
+    }
+
+    func test_requestFlightId_isNotATransferFlightId() {
+        XCTAssertNil(walletGramRequestFlightMessageId("pending:1f2e3d"))
+        XCTAssertNil(walletGramRequestFlightMessageId("request:1:2"))
+        XCTAssertNil(walletGramRequestFlightMessageId("request:a:0:3"))
+    }
+}
