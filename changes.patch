+/// "You requested 250 Grams ($312.50) from imogen" for the requester, "Caesar requested 250 Grams ($312.50)" for the
+/// payer. The name links to the other person, as on a transfer card.
+private func walletRequestServiceMessageString(
+    presentationData: (PresentationTheme, TelegramWallpaper),
+    strings: PresentationStrings,
+    dateTimeFormat: PresentationDateTimeFormat,
+    message: EngineMessage,
+    isIncoming: Bool,
+    amount: Int64,
+    fiatValue: String?
+) -> NSAttributedString {
+    let primaryTextColor = serviceMessageColorComponents(theme: presentationData.0, wallpaper: presentationData.1).primaryText
+    let regularFont = Font.regular(13.0)
+    let semiboldFont = Font.semibold(13.0)
+    let conversationPeer = message.enginePeers[message.id.peerId] ?? message.author
+    let peerName = conversationPeer?.compactDisplayTitle ?? ""
+    var peerMentionAttributes: [NSAttributedString.Key: Any] = [:]
+    if let peerId = conversationPeer?.id {
+        peerMentionAttributes[NSAttributedString.Key(rawValue: TelegramTextAttributes.PeerMention)] = TelegramPeerMention(peerId: peerId, mention: "")
+    }
+    let amountText = formatTonAmountText(
+        amount,
+        dateTimeFormat: dateTimeFormat,
+        maxDecimalPositions: 3,
+        formatString: strings.Currency_Grams
+    )
+    let text: PresentationStrings.FormattedString
+    let nameIndex: Int
+    let amountIndex: Int
+    if isIncoming {
+        text = fiatValue.map { strings.Notification_GramRequest_WithFiat(peerName, amountText, $0) } ?? strings.Notification_GramRequest(peerName, amountText)
+        nameIndex = 0
+        amountIndex = 1
+    } else if let fiatValue {
+        text = strings.Notification_GramRequestYou_WithFiat(amountText, fiatValue, peerName)
+        nameIndex = 2
+        amountIndex = 0
+    } else {
+        text = strings.Notification_GramRequestYou(amountText, peerName)
+        nameIndex = 1
+        amountIndex = 0
+    }
+    let result = NSMutableAttributedString(string: text.string, font: regularFont, textColor: primaryTextColor)
+    for range in text.ranges {
+        if range.index == nameIndex {
+            result.addAttributes(peerMentionAttributes, range: range.range)
+            if isIncoming {
+                result.addAttribute(.font, value: semiboldFont, range: range.range)
+            }
+        } else if range.index == amountIndex {
+            result.addAttribute(.font, value: semiboldFont, range: range.range)
+        }
+    }
+    return result
+}
