+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+
+/// Request GRAM settings from the app config. The server enforces every limit; the client reads them only to
+/// hide what will be refused and to explain it (the "N of 5 requests left today" line, the card's expiry).
+public struct GramRequestConfiguration: Equatable, Sendable {
+    public static let defaultValue = GramRequestConfiguration(isEnabled: false, dailyLimit: 5, minAccountAgeDays: 7, ttlSeconds: 86400)
+
+    /// `gram_requests_enabled`, off by default.
+    public let isEnabled: Bool
+    /// `gram_request_daily_limit`: requests per requester per rolling 24 hours, across all chats.
+    public let dailyLimit: Int32
+    /// `gram_request_min_account_age_days`. The client cannot see account age; this is informational.
+    public let minAccountAgeDays: Int32
+    /// `gram_request_ttl_seconds`: how long a request stays payable.
+    public let ttlSeconds: Int32
+
+    public init(isEnabled: Bool, dailyLimit: Int32, minAccountAgeDays: Int32, ttlSeconds: Int32) {
+        self.isEnabled = isEnabled
+        self.dailyLimit = dailyLimit
+        self.minAccountAgeDays = minAccountAgeDays
+        self.ttlSeconds = ttlSeconds
+    }
+
+    public static func with(appConfiguration: AppConfiguration) -> GramRequestConfiguration {
+        guard let data = appConfiguration.data else {
+            return .defaultValue
+        }
+        func positiveValue(_ key: String, _ fallback: Int32) -> Int32 {
+            if let value = data[key] as? Double, value >= 1.0, value <= Double(Int32.max) {
+                return Int32(value)
+            }
+            return fallback
+        }
+        return GramRequestConfiguration(
+            isEnabled: data["gram_requests_enabled"] as? Bool ?? GramRequestConfiguration.defaultValue.isEnabled,
+            dailyLimit: positiveValue("gram_request_daily_limit", GramRequestConfiguration.defaultValue.dailyLimit),
+            minAccountAgeDays: positiveValue("gram_request_min_account_age_days", GramRequestConfiguration.defaultValue.minAccountAgeDays),
+            ttlSeconds: positiveValue("gram_request_ttl_seconds", GramRequestConfiguration.defaultValue.ttlSeconds)
+        )
+    }
+}
+
+/// Why the server refuses to let the account request GRAM from a user.
+///
+/// Every rule is enforced by the server; the client mirrors the ones it can see only to explain them before
+/// the user tries. The server reports the reason as an RPC error text on `wallet.requestGram` and in the
+/// `reason` of `wallet.getGramRequestEligibility`, both using the codes below.
+public enum GramRequestIneligibilityReason: Equatable, Sendable {
+    /// `GRAM_REQUESTS_DISABLED`: the feature is off for this account.
+    case featureDisabled
+    /// `GRAM_REQUEST_USERNAME_REQUIRED`: the requester has no public username.
+    case usernameRequired
+    /// `GRAM_REQUEST_ACCOUNT_TOO_NEW`: the requester's account is younger than `gram_request_min_account_age_days`.
+    case accountTooNew
+    /// `GRAM_REQUEST_DAILY_LIMIT`: the requester used `gram_request_daily_limit` requests in the last 24 hours.
+    case dailyLimit
+    /// `GRAM_REQUEST_PENDING_EXISTS`: this chat already has a pending request.
+    case pendingRequestExists
+    /// `GRAM_REQUEST_PRIVACY`: the payer's "Who can request GRAM from me" setting excludes the requester.
+    case privacy
+    /// `GRAM_REQUEST_NO_CONVERSATION`: the payer never wrote to the requester and has not added them as a contact.
+    case noConversation
+    /// `GRAM_REQUEST_PAID_MESSAGES`: the payer charges the requester Stars for messages.
+    case paidMessages
+    /// `GRAM_REQUEST_RESTRICTED`: the requester is spam-restricted, or either account is marked scam or fake.
+    case restricted
+    /// `GRAM_REQUEST_AMOUNT_INVALID`: the amount is outside the allowed range.
+    case amountInvalid
+    /// Any other code. Shown as a generic refusal.
+    case other(String)
+
+    public init(errorText: String) {
+        switch errorText {
+        case "GRAM_REQUESTS_DISABLED":
+            self = .featureDisabled
+        case "GRAM_REQUEST_USERNAME_REQUIRED":
+            self = .usernameRequired
+        case "GRAM_REQUEST_ACCOUNT_TOO_NEW":
+            self = .accountTooNew
+        case "GRAM_REQUEST_DAILY_LIMIT":
+            self = .dailyLimit
+        case "GRAM_REQUEST_PENDING_EXISTS":
+            self = .pendingRequestExists
+        case "GRAM_REQUEST_PRIVACY":
+            self = .privacy
+        case "GRAM_REQUEST_NO_CONVERSATION":
+            self = .noConversation
+        case "GRAM_REQUEST_PAID_MESSAGES":
+            self = .paidMessages
+        case "GRAM_REQUEST_RESTRICTED":
+            self = .restricted
+        case "GRAM_REQUEST_AMOUNT_INVALID":
+            self = .amountInvalid
+        default:
+            self = .other(errorText)
+        }
+    }
+
+    /// Whether `errorText` is one of the eligibility codes above, as opposed to an error about one request.
+    static func isIneligibilityError(_ errorText: String) -> Bool {
+        return errorText == "GRAM_REQUESTS_DISABLED" || errorText.hasPrefix("GRAM_REQUEST_") && GramRequestError.requestErrorTexts[errorText] == nil
+    }
+}
+
+public struct GramRequestEligibility: Equatable, Sendable {
+    public let isAllowed: Bool
+    public let reason: GramRequestIneligibilityReason?
+    public let remainingToday: Int32
+
+    public init(isAllowed: Bool, reason: GramRequestIneligibilityReason?, remainingToday: Int32) {
+        self.isAllowed = isAllowed
+        self.reason = reason
+        self.remainingToday = remainingToday
+    }
+}
+
+public enum GramRequestError: Error, Equatable, Sendable {
+    case ineligible(GramRequestIneligibilityReason)
+    /// The request message does not exist, or is not a request.
+    case notFound
+    /// The request was already paid, declined or cancelled.
+    case notPending
+    /// The request's TTL ran out.
+    case expired
+    case network
+    case generic
+
+    fileprivate static let requestErrorTexts: [String: GramRequestError] = [
+        "GRAM_REQUEST_NOT_FOUND": .notFound,
+        "GRAM_REQUEST_NOT_PENDING": .notPending,
+        "GRAM_REQUEST_EXPIRED": .expired
+    ]
+
+    init(errorText: String, errorCode: Int32) {
+        if let error = GramRequestError.requestErrorTexts[errorText] {
+            self = error
+        } else if errorText == "MESSAGE_ID_INVALID" {
+            self = .notFound
+        } else if GramRequestIneligibilityReason.isIneligibilityError(errorText) {
+            self = .ineligible(GramRequestIneligibilityReason(errorText: errorText))
+        } else if errorCode < 0 {
+            self = .network
+        } else {
+            self = .generic
+        }
+    }
+}
+
+/// The server's record of a request: what a payment must match. A payer pays to `requesterAddress` from
+/// this record, never to the address in the message, so neither an edited message nor a modified client on
+/// the requester's side can redirect the payment.
+public struct GramRequestRecord: Equatable, Sendable {
+    public let requestId: Int64
+    public let amount: Int64
+    public let requesterAddress: String
+    public let expiresAt: Int32
+    public let status: TelegramGramRequestStatus
+    public let comment: String?
+    /// The requester's username changed in the last 7 days (server-side history the client cannot see).
+    public let usernameRecentlyChanged: Bool
+    /// The account (the payer) has never sent a message to the requester.
+    public let noOutgoingMessages: Bool
+
+    public init(requestId: Int64, amount: Int64, requesterAddress: String, expiresAt: Int32, status: TelegramGramRequestStatus, comment: String?, usernameRecentlyChanged: Bool, noOutgoingMessages: Bool) {
+        self.requestId = requestId
+        self.amount = amount
+        self.requesterAddress = requesterAddress
+        self.expiresAt = expiresAt
+        self.status = status
+        self.comment = comment
+        self.usernameRecentlyChanged = usernameRecentlyChanged
+        self.noOutgoingMessages = noOutgoingMessages
+    }
+}
+
+extension GramRequestEligibility {
+    init(apiEligibility: Api.wallet.GramRequestEligibility) {
+        switch apiEligibility {
+        case let .gramRequestEligibility(data):
+            let isAllowed = (data.flags & (1 << 0)) != 0
+            var reason: GramRequestIneligibilityReason?
+            if !isAllowed {
+                reason = GramRequestIneligibilityReason(errorText: data.reason ?? "")
+            }
+            self.init(
+                isAllowed: isAllowed,
+                reason: reason,
+                remainingToday: max(0, data.remainingToday)
+            )
+        }
+    }
+}
+
+extension GramRequestRecord {
+    init(apiRequest: Api.wallet.GramRequest) {
+        switch apiRequest {
+        case let .gramRequest(data):
+            self.init(
+                requestId: data.requestId,
+                amount: data.amount,
+                requesterAddress: data.requesterAddress,
+                expiresAt: data.expiresAt,
+                status: TelegramGramRequestStatus(apiStatus: data.status),
+                comment: data.comment,
+                usernameRecentlyChanged: (data.flags & (1 << 1)) != 0,
+                noOutgoingMessages: (data.flags & (1 << 2)) != 0
+            )
+        }
+    }
+}
+
+private func gramRequestInputUser(account: Account, peerId: PeerId) -> Signal<Api.InputUser, GramRequestError> {
+    return account.postbox.transaction { transaction -> Api.InputUser? in
+        guard peerId.namespace == Namespaces.Peer.CloudUser, let peer = transaction.getPeer(peerId) else {
+            return nil
+        }
+        return apiInputUser(peer)
+    }
+    |> castError(GramRequestError.self)
+    |> mapToSignal { inputUser -> Signal<Api.InputUser, GramRequestError> in
+        guard let inputUser else {
+            return .fail(.generic)
+        }
+        return .single(inputUser)
+    }
+}
+
+/// The id of the request message the server created, read from the `updateMessageID` that carries the call's
+/// `random_id`, or from the one message the updates hold when the server answers without it.
+func gramRequestCreatedMessageId(updates: Api.Updates, peerId: PeerId, randomId: Int64) -> MessageId? {
+    for update in updates.allUpdates {
+        if case let .updateMessageID(data) = update, data.randomId == randomId {
+            return MessageId(peerId: peerId, namespace: Namespaces.Message.Cloud, id: data.id)
+        }
+    }
+    let rawIds = updates.rawMessageIds
+    if rawIds.count == 1, let id = rawIds.first {
+        return MessageId(peerId: peerId, namespace: Namespaces.Message.Cloud, id: id)
+    }
+    return nil
+}
+
+func _internal_requestGram(account: Account, peerId: PeerId, amount: Int64, comment: String?) -> Signal<MessageId?, GramRequestError> {
+    guard amount > 0 else {
+        return .fail(.ineligible(.amountInvalid))
+    }
+    let comment = comment?.trimmingCharacters(in: .whitespacesAndNewlines)
+    return gramRequestInputUser(account: account, peerId: peerId)
+    |> mapToSignal { inputUser -> Signal<MessageId?, GramRequestError> in
+        var flags: Int32 = 0
+        if let comment, !comment.isEmpty {
+            flags |= 1 << 0
+        }
+        let randomId = Int64.random(in: Int64.min ... Int64.max)
+        return account.network.request(Api.functions.wallet.requestGram(
+            flags: flags,
+            peer: inputUser,
+            amount: amount,
+            comment: (flags & (1 << 0)) != 0 ? comment : nil,
+            randomId: randomId
+        ), automaticFloodWait: false)
+        |> mapError { error -> GramRequestError in
+            return GramRequestError(errorText: error.errorDescription, errorCode: error.errorCode)
+        }
+        |> mapToSignal { updates -> Signal<MessageId?, GramRequestError> in
+            let messageId = gramRequestCreatedMessageId(updates: updates, peerId: peerId, randomId: randomId)
+            account.stateManager.addUpdates(updates)
+            return .single(messageId)
+        }
+    }
+}
+
+func _internal_cancelGramRequest(account: Account, messageId: MessageId) -> Signal<Never, GramRequestError> {
+    return gramRequestInputUser(account: account, peerId: messageId.peerId)
+    |> mapToSignal { inputUser -> Signal<Never, GramRequestError> in
+        return account.network.request(Api.functions.wallet.cancelGramRequest(peer: inputUser, msgId: messageId.id))
+        |> mapError { error -> GramRequestError in
+            return GramRequestError(errorText: error.errorDescription, errorCode: error.errorCode)
+        }
+        |> mapToSignal { updates -> Signal<Never, GramRequestError> in
+            account.stateManager.addUpdates(updates)
+            return .complete()
+        }
+    }
+}
+
+func _internal_declineGramRequest(account: Account, messageId: MessageId) -> Signal<Never, GramRequestError> {
+    return gramRequestInputUser(account: account, peerId: messageId.peerId)
+    |> mapToSignal { inputUser -> Signal<Never, GramRequestError> in
+        return account.network.request(Api.functions.wallet.declineGramRequest(peer: inputUser, msgId: messageId.id))
+        |> mapError { error -> GramRequestError in
+            return GramRequestError(errorText: error.errorDescription, errorCode: error.errorCode)
+        }
+        |> mapToSignal { updates -> Signal<Never, GramRequestError> in
+            account.stateManager.addUpdates(updates)
+            return .complete()
+        }
+    }
+}
+
+/// The server's verdict on whether the account may request GRAM from `peerId` now, or nil when it cannot be
+/// fetched; the request itself is still checked by the server when it is sent.
+func _internal_gramRequestEligibility(account: Account, peerId: PeerId) -> Signal<GramRequestEligibility?, NoError> {
+    return gramRequestInputUser(account: account, peerId: peerId)
+    |> mapToSignal { inputUser -> Signal<GramRequestEligibility?, GramRequestError> in
+        return account.network.request(Api.functions.wallet.getGramRequestEligibility(peer: inputUser))
+        |> mapError { error -> GramRequestError in
+            return GramRequestError(errorText: error.errorDescription, errorCode: error.errorCode)
+        }
+        |> map { result -> GramRequestEligibility? in
+            return GramRequestEligibility(apiEligibility: result)
+        }
+    }
+    |> `catch` { _ -> Signal<GramRequestEligibility?, NoError> in
+        return .single(nil)
+    }
+}
+
+func _internal_gramRequestRecord(account: Account, messageId: MessageId) -> Signal<GramRequestRecord, GramRequestError> {
+    return gramRequestInputUser(account: account, peerId: messageId.peerId)
+    |> mapToSignal { inputUser -> Signal<GramRequestRecord, GramRequestError> in
+        return account.network.request(Api.functions.wallet.getGramRequest(peer: inputUser, msgId: messageId.id))
+        |> mapError { error -> GramRequestError in
+            return GramRequestError(errorText: error.errorDescription, errorCode: error.errorCode)
+        }
+        |> map { result -> GramRequestRecord in
+            return GramRequestRecord(apiRequest: result)
+        }
+    }
+}
+
+public extension TelegramEngine.Wallet {
+    /// Asks `peerId` for `amount` nanograms. The request appears in the private chat as a
+    /// `.gramRequest` message once the server accepts it; the signal delivers that message's id (nil when the
+    /// server's answer does not name it) and completes.
+    func requestGram(peerId: EnginePeer.Id, amount: Int64, comment: String?) -> Signal<EngineMessage.Id?, GramRequestError> {
+        return _internal_requestGram(account: self.account, peerId: peerId, amount: amount, comment: comment)
+    }
+
+    /// Withdraws a pending request the account sent.
+    func cancelGramRequest(messageId: EngineMessage.Id) -> Signal<Never, GramRequestError> {
+        return _internal_cancelGramRequest(account: self.account, messageId: messageId)
+    }
+
+    /// Refuses a pending request the account received.
+    func declineGramRequest(messageId: EngineMessage.Id) -> Signal<Never, GramRequestError> {
+        return _internal_declineGramRequest(account: self.account, messageId: messageId)
+    }
+
+    func gramRequestEligibility(peerId: EnginePeer.Id) -> Signal<GramRequestEligibility?, NoError> {
+        return _internal_gramRequestEligibility(account: self.account, peerId: peerId)
+    }
+
+    /// The server's record of the request in `messageId`, which a payment must be built from.
+    func gramRequestRecord(messageId: EngineMessage.Id) -> Signal<GramRequestRecord, GramRequestError> {
+        return _internal_gramRequestRecord(account: self.account, messageId: messageId)
+    }
+}
