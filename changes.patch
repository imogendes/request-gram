diff --git a/submodules/TelegramUI/Sources/ChatControllerGramRequests.swift b/submodules/TelegramUI/Sources/ChatControllerGramRequests.swift
new file mode 100644
index 000000000..9a90051f3
--- /dev/null
+++ b/submodules/TelegramUI/Sources/ChatControllerGramRequests.swift
@@ -0,0 +1,48 @@
+import Foundation
+import AccountContext
+import TelegramCore
+import SwiftSignalKit
+import Display
+import TelegramPresentationData
+import PresentationDataUtils
+import UndoUI
+
+extension ChatControllerImpl {
+    /// Cancel (the requester) or Decline (the payer) a pending Request GRAM request, after a confirmation. The
+    /// server sends both sides a status update that turns the card in place.
+    func confirmGramRequestChange(messageId: EngineMessage.Id, decline: Bool) {
+        let presentationData = self.presentationData
+        let strings = presentationData.strings
+        let peerName = self.presentationInterfaceState.renderedPeer?.peer.flatMap(EnginePeer.init)?.compactDisplayTitle ?? ""
+        let title = decline ? strings.Chat_GramRequest_DeclineConfirmation_Title : strings.Chat_GramRequest_CancelConfirmation_Title
+        let text = decline ? strings.Chat_GramRequest_DeclineConfirmation_Text(peerName).string : strings.Chat_GramRequest_CancelConfirmation_Text(peerName).string
+        let actionTitle = decline ? strings.Chat_GramRequest_Decline : strings.Chat_GramRequest_Cancel
+        self.present(textAlertController(
+            context: self.context,
+            updatedPresentationData: self.updatedPresentationData,
+            title: title,
+            text: text,
+            actions: [
+                TextAlertAction(type: .genericAction, title: strings.Common_Cancel, action: {}),
+                TextAlertAction(type: .destructiveAction, title: actionTitle, action: { [weak self] in
+                    self?.commitGramRequestChange(messageId: messageId, decline: decline)
+                })
+            ]
+        ), in: .window(.root))
+    }
+
+    private func commitGramRequestChange(messageId: EngineMessage.Id, decline: Bool) {
+        let signal = decline ? self.context.engine.wallet.declineGramRequest(messageId: messageId) : self.context.engine.wallet.cancelGramRequest(messageId: messageId)
+        let _ = (signal
+        |> deliverOnMainQueue).startStandalone(error: { [weak self] _ in
+            guard let self else {
+                return
+            }
+            self.present(UndoOverlayController(
+                presentationData: self.presentationData,
+                content: .info(title: nil, text: self.presentationData.strings.Chat_GramRequest_Unavailable, timeout: nil, customUndoText: nil),
+                action: { _ in return false }
+            ), in: .current)
+        })
+    }
+}
