+private final class WalletGramRequestSheetComponent: CombinedComponent {
+    typealias EnvironmentType = ViewControllerComponentContainer.Environment
+
+    let context: AccountContext
+    let messageId: EngineMessage.Id
+
+    init(context: AccountContext, messageId: EngineMessage.Id) {
+        self.context = context
+        self.messageId = messageId
+    }
+
+    static func ==(lhs: WalletGramRequestSheetComponent, rhs: WalletGramRequestSheetComponent) -> Bool {
+        return lhs.context === rhs.context && lhs.messageId == rhs.messageId
+    }
+
+    static var body: Body {
+        let sheet = Child(SheetComponent<EnvironmentType>.self)
+        let animateOut = StoredActionSlot(Action<Void>.self)
+        let sheetExternalState = SheetComponent<EnvironmentType>.ExternalState()
+
+        return { context in
+            let environment = context.environment[EnvironmentType.self]
+            let controller = environment.controller
+            let dismiss: (Bool) -> Void = { animated in
+                guard let controller = controller() as? WalletGramRequestScreen else {
+                    return
+                }
+                if animated {
+                    animateOut.invoke(Action { _ in
+                        controller.dismiss(completion: nil)
+                    })
+                } else {
+                    controller.dismiss(completion: nil)
+                }
+            }
+            let sheetComponent = sheet.update(
+                component: SheetComponent<EnvironmentType>(
+                    content: AnyComponent<EnvironmentType>(WalletGramRequestContentComponent(
+                        context: context.component.context,
+                        messageId: context.component.messageId,
+                        close: {
+                            dismiss(true)
+                        }
+                    )),
+                    style: .glass,
+                    backgroundColor: .color(environment.theme.actionSheet.opaqueItemBackgroundColor),
+                    followContentSizeChanges: true,
+                    clipsContent: true,
+                    autoAnimateOut: false,
+                    externalState: sheetExternalState,
+                    animateOut: animateOut,
+                    onPan: {
+                    },
+                    willDismiss: {
+                    }
+                ),
+                environment: {
+                    environment
+                    SheetComponentEnvironment(
+                        metrics: environment.metrics,
+                        deviceMetrics: environment.deviceMetrics,
+                        isDisplaying: environment.value.isVisible,
+                        isCentered: environment.presentsFloatingPanels,
+                        hasInputHeight: !environment.inputHeight.isZero,
+                        regularMetricsSize: CGSize(width: 430.0, height: 900.0),
+                        dismiss: { animated in
+                            dismiss(animated)
+                        }
+                    )
+                },
+                availableSize: context.availableSize,
+                transition: context.transition
+            )
+            context.add(sheetComponent.position(CGPoint(x: context.availableSize.width / 2.0, y: context.availableSize.height / 2.0)))
+
+            if let controller = controller(), !controller.automaticallyControlPresentationContextLayout {
+                var sideInset: CGFloat = 0.0
+                var bottomInset: CGFloat = max(environment.safeInsets.bottom, sheetExternalState.contentHeight)
+                if case .regular = environment.metrics.widthClass {
+                    sideInset = floor((context.availableSize.width - 430.0) / 2.0) - 12.0
+                    bottomInset = (context.availableSize.height - sheetExternalState.contentHeight) / 2.0 + sheetExternalState.contentHeight
+                }
+                controller.presentationContext.containerLayoutUpdated(
+                    ContainerViewLayout(
+                        size: context.availableSize,
+                        metrics: environment.metrics,
+                        deviceMetrics: environment.deviceMetrics,
+                        intrinsicInsets: UIEdgeInsets(top: 0.0, left: 0.0, bottom: bottomInset, right: 0.0),
+                        safeInsets: UIEdgeInsets(top: 0.0, left: max(sideInset, environment.safeInsets.left), bottom: 0.0, right: max(sideInset, environment.safeInsets.right)),
+                        reservedCorners: environment.reservedCorners,
+                        division: nil,
+                        additionalInsets: .zero,
+                        statusBarHeight: environment.fullStatusBarHeight,
+                        inputHeight: nil,
+                        inputHeightIsInteractivellyChanging: false,
+                        inVoiceOver: false,
+                        presentedInFormSheet: false
+                    ),
+                    transition: context.transition.containedViewLayoutTransition
+                )
+            }
+            return context.availableSize
+        }
+    }
+}
+
+/// The details of a Request GRAM request, opened from its card in the chat: the amount and comment, who asked
+/// (with their username), where the money would go, and for the payer, Send. Built from the transaction
+/// sheet's parts.
+public final class WalletGramRequestScreen: ViewControllerComponentContainer {
+    public init(context: AccountContext, messageId: EngineMessage.Id) {
+        super.init(
+            context: context,
+            component: WalletGramRequestSheetComponent(context: context, messageId: messageId),
+            navigationBarAppearance: .none,
+            statusBarStyle: .ignore,
+            theme: .default
+        )
+        self.navigationPresentation = .flatModal
+        self.automaticallyControlPresentationContextLayout = false
+    }
+
+    required public init(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    public override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.disablesInteractiveModalDismiss = true
+    }
+
+    /// Opens the request in `messageId`; the first time the account opens a request it received, the safety tips
+    /// come first, with a shortcut to "Who can request GRAM from me".
+    public static func open(context: AccountContext, messageId: EngineMessage.Id, isIncoming: Bool, push: @escaping (ViewController) -> Void) {
+        let openRequest = {
+            push(WalletGramRequestScreen(context: context, messageId: messageId))
+        }
+        guard isIncoming else {
+            openRequest()
+            return
+        }
+        let _ = (ApplicationSpecificNotice.getGramRequestSafetyTips(accountManager: context.sharedContext.accountManager)
+        |> deliverOnMainQueue).startStandalone(next: { shown in
+            if shown {
+                openRequest()
+                return
+            }
+            let _ = ApplicationSpecificNotice.setGramRequestSafetyTips(accountManager: context.sharedContext.accountManager).startStandalone()
+            let strings = context.sharedContext.currentPresentationData.with { $0 }.strings
+            push(WalletInfoScreen(
+                context: context,
+                mode: .gramRequestSafety,
+                secondaryAction: WalletInfoScreen.SecondaryAction(title: strings.Wallet_GramRequest_Safety_TurnOff, action: {
+                    context.sharedContext.openGramRequestsPrivacyController(context: context, present: push)
+                }),
+                completion: openRequest
+            ))
+        })
+    }
+}
