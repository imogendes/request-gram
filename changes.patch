+
+/// The Request GRAM request in a chat message, as the sheet reads it.
+private struct WalletGramRequestMessageContent: Equatable {
+    let messageId: EngineMessage.Id
+    let timestamp: Int32
+    let isIncoming: Bool
+    let amount: Int64
+    let requesterAddress: String
+    let requestId: Int64
+    let expiresAt: Int32
+    let comment: String?
+    let status: TelegramGramRequestStatus
+
+    init?(message: EngineMessage, accountPeerId: EnginePeer.Id) {
+        let found = message.media.lazy.compactMap { media -> (Int64, String, Int64, Int32, String?, TelegramGramRequestStatus)? in
+            guard let action = media as? TelegramMediaAction,
+                  case let .gramRequest(amount, requesterAddress, requestId, expiresAt, comment, status) = action.action else {
+                return nil
+            }
+            return (amount, requesterAddress, requestId, expiresAt, comment, status)
+        }.first
+        guard let found else {
+            return nil
+        }
+        let (amount, requesterAddress, requestId, expiresAt, comment, status) = found
+        self.messageId = message.id
+        self.timestamp = message.timestamp
+        self.isIncoming = message.effectivelyIncoming(accountPeerId)
+        self.amount = amount
+        self.requesterAddress = requesterAddress
+        self.requestId = requestId
+        self.expiresAt = expiresAt
+        self.comment = comment
+        self.status = status
+    }
+
+    func effectiveStatus(at timestamp: Int32) -> TelegramGramRequestStatus {
+        return self.status.effective(expiresAt: self.expiresAt, timestamp: timestamp)
+    }
+}
+
+private func walletGramRequestNow() -> Int32 {
+    return Int32(Date().timeIntervalSince1970)
+}
+
+private final class WalletGramRequestContentComponent: Component {
+    typealias EnvironmentType = ViewControllerComponentContainer.Environment
+
+    let context: AccountContext
+    let messageId: EngineMessage.Id
+    let close: () -> Void
+
+    init(context: AccountContext, messageId: EngineMessage.Id, close: @escaping () -> Void) {
+        self.context = context
+        self.messageId = messageId
+        self.close = close
+    }
+
+    static func ==(lhs: WalletGramRequestContentComponent, rhs: WalletGramRequestContentComponent) -> Bool {
+        return lhs.context === rhs.context && lhs.messageId == rhs.messageId
+    }
+
+    final class View: UIView {
+        private let controlButtons = ComponentView<Empty>()
+        private let gramAnimation = ComponentView<Empty>()
+        private let amount = ComponentView<Empty>()
+        private let fiatValue = ComponentView<Empty>()
+        private let commentBackgroundView = WalletSendCommentBackgroundView(frame: .zero)
+        private let commentText = ComponentView<Empty>()
+        private let table = ComponentView<Empty>()
+        private var warningViews: [ComponentView<Empty>] = []
+        private let gramInfoButton = ComponentView<Empty>()
+        private let actionButton = ComponentView<Empty>()
+
+        private var component: WalletGramRequestContentComponent?
+        private var environment: EnvironmentType?
+        private weak var componentState: EmptyComponentState?
+
+        private var request: WalletGramRequestMessageContent?
+        private var requester: EnginePeer?
+        private var requesterIsContact = true
+        private var record: GramRequestRecord?
+        private var fiatState: WalletContext.FiatState?
+        private var isPaying = false
+        private var didPay = false
+
+        private let dataDisposable = MetaDisposable()
+        private let recordDisposable = MetaDisposable()
+        private let walletDisposable = MetaDisposable()
+        private let payDisposable = MetaDisposable()
+        private let signingAccessDisposable = MetaDisposable()
+        private var paySession: PasscodeSession?
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            self.commentBackgroundView.isUserInteractionEnabled = false
+            self.addSubview(self.commentBackgroundView)
+        }
+
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+
+        deinit {
+            self.dataDisposable.dispose()
+            self.recordDisposable.dispose()
+            self.walletDisposable.dispose()
+            self.payDisposable.dispose()
+            self.signingAccessDisposable.dispose()
+            self.paySession?.invalidate()
+        }
+
+        private var presentationData: PresentationData? {
+            return self.component?.context.sharedContext.currentPresentationData.with { $0 }
+        }
+
+        private func subscribe(component: WalletGramRequestContentComponent) {
+            let context = component.context
+            let accountPeerId = context.account.peerId
+            let messageId = component.messageId
+            self.dataDisposable.set((context.engine.data.subscribe(TelegramEngine.EngineData.Item.Messages.Message(id: messageId))
+            |> mapToSignal { message -> Signal<(EngineMessage?, EnginePeer?, Bool), NoError> in
+                guard let message, let author = message.author else {
+                    return .single((message, nil, true))
+                }
+                return context.engine.data.subscribe(
+                    TelegramEngine.EngineData.Item.Peer.Peer(id: author.id),
+                    TelegramEngine.EngineData.Item.Peer.IsContact(id: author.id)
+                )
+                |> map { peer, isContact -> (EngineMessage?, EnginePeer?, Bool) in
+                    return (message, peer ?? author, isContact)
+                }
+            }
+            |> deliverOnMainQueue).start(next: { [weak self] message, requester, isContact in
+                guard let self else {
+                    return
+                }
+                let previous = self.request
+                self.request = message.flatMap { WalletGramRequestMessageContent(message: $0, accountPeerId: accountPeerId) }
+                self.requester = requester
+                self.requesterIsContact = isContact
+                if let request = self.request, request.isIncoming, request.effectiveStatus(at: walletGramRequestNow()).isPending, previous == nil {
+                    self.fetchRecord(messageId: request.messageId)
+                }
+                self.componentState?.updated(transition: previous == nil ? .immediate : .easeInOut(duration: 0.25))
+            }))
+
+            if let walletContext = context.walletContext {
+                self.fiatState = walletContext.stateValue.fiat
+                self.walletDisposable.set((walletContext.state
+                |> map { $0.fiat }
+                |> distinctUntilChanged
+                |> deliverOnMainQueue).start(next: { [weak self] fiat in
+                    self?.fiatState = fiat
+                    self?.componentState?.updated(transition: .immediate)
+                }))
+            }
+        }
+
+        /// The server's record, for the warnings shown before paying. The payment fetches it again.
+        private func fetchRecord(messageId: EngineMessage.Id) {
+            guard let component = self.component else {
+                return
+            }
+            self.recordDisposable.set((component.context.engine.wallet.gramRequestRecord(messageId: messageId)
+            |> deliverOnMainQueue).start(next: { [weak self] record in
+                self?.record = record
+                self?.componentState?.updated(transition: .easeInOut(duration: 0.2))
+            }))
+        }
+
+        private func copyAddress(_ address: String) {
+            UIPasteboard.general.string = address
+            guard let presentationData = self.presentationData, let controller = self.environment?.controller() else {
+                return
+            }
+            controller.present(UndoOverlayController(
+                presentationData: presentationData,
+                content: .copy(text: presentationData.strings.Wallet_TonAddressCopied),
+                position: .bottom,
+                action: { _ in return false }
+            ), in: .current)
+        }
+
+        private func presentAlert(title: String?, text: String) {
+            guard let component = self.component, let controller = self.environment?.controller(),
+                  let presentationData = self.presentationData else {
+                return
+            }
+            controller.present(textAlertController(
+                context: component.context,
+                title: title,
+                text: text,
+                actions: [TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_OK, action: {})]
+            ), in: .window(.root))
+        }
+
+        private func finishPaying(error: WalletContext.WalletError?) {
+            self.isPaying = false
+            self.paySession?.invalidate()
+            self.paySession = nil
+            self.componentState?.updated(transition: .easeInOut(duration: 0.2))
+            guard let error, error != .authorizationCancelled, let presentationData = self.presentationData else {
+                return
+            }
+            let strings = presentationData.strings
+            switch error {
+            case .gramRequestUnavailable:
+                self.presentAlert(title: nil, text: strings.Wallet_GramRequest_Error_Unavailable)
+            case let .insufficientBalance(required):
+                let amountText = formatTonAmountText(required, dateTimeFormat: presentationData.dateTimeFormat, maxDecimalPositions: 3, formatString: strings.Currency_Grams)
+                self.presentAlert(title: strings.Wallet_Transfer_ErrorTitle, text: strings.Wallet_Send_InsufficientFunds + " " + amountText)
+            default:
+                if let message = walletAuthorizationErrorMessage(error, strings: strings) {
+                    self.presentAlert(title: message.title, text: message.text)
+                } else {
+                    self.presentAlert(title: strings.Wallet_Transfer_ErrorTitle, text: strings.Wallet_Transfer_ErrorText)
+                }
+            }
+        }
+
+        /// Pays the request. Every step re-checks the request with the server; nothing is signed until the
+        /// device owner confirms with Face ID, Touch ID or the device passcode, on every payment.
+        private func pay() {
+            guard let component = self.component, let request = self.request, let requester = self.requester,
+                  request.isIncoming, !self.isPaying, !self.didPay,
+                  request.effectiveStatus(at: walletGramRequestNow()).isPending,
+                  let presentationData = self.presentationData else {
+                return
+            }
+            guard let walletContext = component.context.walletContext,
+                  case let .wallet(walletInfo) = walletContext.stateValue.phase else {
+                self.presentAlert(title: nil, text: presentationData.strings.Wallet_Unavailable)
+                return
+            }
+            if !walletInfo.canSign {
+                self.resolveSigningAccess(walletContext: walletContext, walletInfo: walletInfo)
+                return
+            }
+            self.isPaying = true
+            self.componentState?.updated(transition: .easeInOut(duration: 0.2))
+
+            let context = component.context
+            let strings = presentationData.strings
+            // 1. The server's record and the requester's wallet as the server knows it: the payment is built from
+            // these, never from the message.
+            self.payDisposable.set((combineLatest(
+                context.engine.wallet.gramRequestRecord(messageId: request.messageId)
+                |> map(Optional.init)
+                |> `catch` { _ -> Signal<GramRequestRecord?, NoError> in
+                    return .single(nil)
+                },
+                context.engine.wallet.getUserAddresses(userIds: [requester.id], force: true)
+                |> `catch` { _ -> Signal<[WalletUserAddress], NoError> in
+                    return .single([])
+                }
+            )
+            |> take(1)
+            |> deliverOnMainQueue).start(next: { [weak self] record, addresses in
+                guard let self else {
+                    return
+                }
+                guard let record else {
+                    self.finishPaying(error: nil)
+                    self.presentAlert(title: nil, text: strings.Wallet_GramRequest_Error_Generic)
+                    return
+                }
+                self.record = record
+                let check = walletGramRequestPaymentCheck(
+                    record: record,
+                    messageRequestId: request.requestId,
+                    messageAmount: request.amount,
+                    messageRequesterAddress: request.requesterAddress,
+                    requesterWalletAddresses: addresses.filter { $0.userId == requester.id }.map(\.address),
+                    timestamp: walletGramRequestNow()
+                )
+                switch check {
+                case .payable:
+                    self.confirmOwnerAndSubmit(walletContext: walletContext, record: record, requester: requester)
+                case .notPayable:
+                    self.finishPaying(error: nil)
+                    self.presentAlert(title: nil, text: strings.Wallet_GramRequest_Error_Unavailable)
+                case .addressMismatch:
+                    self.finishPaying(error: nil)
+                    self.presentAlert(title: nil, text: strings.Wallet_GramRequest_Error_AddressMismatch(requester.compactDisplayTitle).string)
+                }
+            }))
+        }
+
+        /// 2. Face ID, Touch ID or the device passcode, every time. A device without any of them cannot pay requests.
+        private func confirmOwnerAndSubmit(walletContext: WalletContext, record: GramRequestRecord, requester: EnginePeer) {
+            guard let presentationData = self.presentationData else {
+                return
+            }
+            let strings = presentationData.strings
+            let authenticationContext = LAContext()
+            var policyError: NSError?
+            guard authenticationContext.canEvaluatePolicy(.deviceOwnerAuthentication, error: &policyError) else {
+                self.finishPaying(error: nil)
+                self.presentAlert(title: nil, text: strings.Wallet_GramRequest_Error_AuthenticationRequired)
+                return
+            }
+            let amountText = formatTonAmountText(record.amount, dateTimeFormat: presentationData.dateTimeFormat, maxDecimalPositions: 9, formatString: strings.Currency_Grams)
+            let reason = strings.Wallet_GramRequest_ConfirmReason(amountText, requester.compactDisplayTitle).string
+            authenticationContext.evaluatePolicy(.deviceOwnerAuthentication, localizedReason: reason) { [weak self] success, _ in
+                DispatchQueue.main.async {
+                    guard let self else {
+                        return
+                    }
+                    guard success else {
+                        self.finishPaying(error: .authorizationCancelled)
+                        return
+                    }
+                    self.submit(walletContext: walletContext, record: record, requester: requester)
+                }
+            }
+        }
+
+        /// 3. The regular transfer pipeline, to the address from the record, tagged with the request id so the
+        /// server can mark the request paid. No local transfer card is created for it.
+        private func submit(walletContext: WalletContext, record: GramRequestRecord, requester: EnginePeer) {
+            let requesterId = requester.id
+            self.payDisposable.set((walletContext.beginWalletFlow(reason: "Pay Gram request")
+            |> deliverOnMainQueue
+            |> mapToSignal { [weak self] session -> Signal<WalletContext.PreparedTransfer, WalletContext.WalletError> in
+                guard let self else {
+                    session.invalidate()
+                    return .fail(.authorizationCancelled)
+                }
+                self.paySession = session
+                return walletContext.state
+                |> filter { $0.activeOperation == nil }
+                |> take(1)
+                |> castError(WalletContext.WalletError.self)
+                |> mapToSignal { state -> Signal<WalletContext.PreparedTransfer, WalletContext.WalletError> in
+                    guard let balance = state.balance.currentValue, record.amount <= balance else {
+                        return .fail(.insufficientBalance(required: record.amount))
+                    }
+                    return walletContext.prepareTransfer(
+                        address: record.requesterAddress,
+                        amount: record.amount,
+                        comment: nil,
+                        session: session
+                    )
+                }
+            }
+            |> deliverOnMainQueue
+            |> mapToSignal { [weak self] prepared -> Signal<WalletContext.PendingTransfer, WalletContext.WalletError> in
+                guard let session = self?.paySession else {
+                    let _ = walletContext.discardPreparedTransfer(prepared).startStandalone()
+                    return .fail(.authorizationCancelled)
+                }
+                return walletContext.submitTransfer(
+                    prepared,
+                    recipientPeerId: requesterId,
+                    session: session,
+                    gramRequestId: record.requestId
+                )
+            }
+            |> deliverOnMainQueue).start(next: { [weak self] _ in
+                guard let self else {
+                    return
+                }
+                self.didPay = true
+                self.finishPaying(error: nil)
+                self.component?.close()
+            }, error: { [weak self] error in
+                self?.finishPaying(error: error)
+            }))
+        }
+
+        /// The wallet cannot sign on this device yet: restore signing from the backup, as the Send screen does, or
+        /// enter the recovery phrase.
+        private func resolveSigningAccess(walletContext: WalletContext, walletInfo: WalletContext.WalletInfo) {
+            guard let component = self.component, let controller = self.environment?.controller() else {
+                return
+            }
+            if walletInfo.canExportPhrase {
+                self.isPaying = true
+                self.componentState?.updated(transition: .easeInOut(duration: 0.2))
+                var restorationSession: PasscodeSession?
+                self.signingAccessDisposable.set(performWalletAuthorizedOperation(
+                    context: component.context,
+                    present: { [weak controller] alert in
+                        controller?.present(alert, in: .window(.root))
+                    },
+                    operation: { password -> Signal<[String], WalletContext.WalletError> in
+                        return walletContext.beginWalletFlow(reason: "Restore wallet")
+                        |> mapToSignal { session -> Signal<[String], WalletContext.WalletError> in
+                            restorationSession = session
+                            return walletContext.recoveryPhrase(password: password, session: session)
+                        }
+                    },
+                    next: { [weak self] _ in
+                        restorationSession?.invalidate()
+                        guard let self else {
+                            return
+                        }
+                        self.isPaying = false
+                        self.pay()
+                    },
+                    failed: { [weak self] error in
+                        restorationSession?.invalidate()
+                        self?.finishPaying(error: error)
+                    }
+                ))
+            } else {
+                let importController = component.context.sharedContext.makeWalletImportScreen(
+                    context: component.context,
+                    mode: .enterRecoveryPhrase,
+                    completion: {}
+                )
+                controller.push(importController)
+            }
+        }
+
+        private func statusText(_ status: TelegramGramRequestStatus, strings: PresentationStrings) -> String {
+            switch status {
+            case .pending:
+                return strings.Wallet_GramRequest_Status_Pending
