diff --git a/submodules/WalletContext/Sources/WalletGramRequests.swift b/submodules/WalletContext/Sources/WalletGramRequests.swift
new file mode 100644
index 000000000..37d23ac23
--- /dev/null
+++ b/submodules/WalletContext/Sources/WalletGramRequests.swift
@@ -0,0 +1,221 @@
+import Foundation
+import TelegramCore
+
+/// What the Request GRAM screens show when a request cannot be sent, kept free of strings so the mapping from
+/// the server's reasons can be tested (`PresentationStrings` cannot be built in a test process). The screens
+/// turn a notice into text.
+public struct WalletGramRequestNotice: Equatable, Sendable {
+    public enum Kind: Equatable, Sendable {
+        case disabled
+        case usernameRequired
+        case accountTooNew
+        case dailyLimit
+        case pendingRequestExists
+        case privacy
+        case noConversation
+        case paidMessages
+        case restricted
+        case amountInvalid
+        case generic
+    }
+
+    public let kind: Kind
+    /// The Request button stays disabled while this notice applies: sending again cannot succeed until
+    /// something outside the screen changes. Notices that do not block are shown after a failed attempt.
+    public let blocksRequest: Bool
+    /// The notice offers to set a public username.
+    public let offersSetUsername: Bool
+    /// The notice's text names the other person.
+    public let namesPeer: Bool
+
+    public init(kind: Kind, blocksRequest: Bool, offersSetUsername: Bool, namesPeer: Bool) {
+        self.kind = kind
+        self.blocksRequest = blocksRequest
+        self.offersSetUsername = offersSetUsername
+        self.namesPeer = namesPeer
+    }
+
+    public init(reason: GramRequestIneligibilityReason) {
+        switch reason {
+        case .featureDisabled:
+            self.init(kind: .disabled, blocksRequest: true, offersSetUsername: false, namesPeer: false)
+        case .usernameRequired:
+            self.init(kind: .usernameRequired, blocksRequest: true, offersSetUsername: true, namesPeer: false)
+        case .accountTooNew:
+            self.init(kind: .accountTooNew, blocksRequest: true, offersSetUsername: false, namesPeer: false)
+        case .dailyLimit:
+            self.init(kind: .dailyLimit, blocksRequest: true, offersSetUsername: false, namesPeer: false)
+        case .pendingRequestExists:
+            self.init(kind: .pendingRequestExists, blocksRequest: true, offersSetUsername: false, namesPeer: true)
+        case .privacy:
+            self.init(kind: .privacy, blocksRequest: true, offersSetUsername: false, namesPeer: true)
+        case .noConversation:
+            self.init(kind: .noConversation, blocksRequest: true, offersSetUsername: false, namesPeer: false)
+        case .paidMessages:
+            self.init(kind: .paidMessages, blocksRequest: true, offersSetUsername: false, namesPeer: true)
+        case .restricted:
+            self.init(kind: .restricted, blocksRequest: true, offersSetUsername: false, namesPeer: false)
+        case .amountInvalid:
+            self.init(kind: .amountInvalid, blocksRequest: false, offersSetUsername: false, namesPeer: false)
+        case .other:
+            self.init(kind: .generic, blocksRequest: false, offersSetUsername: false, namesPeer: false)
+        }
+    }
+
+    /// The notice for a failed `requestGram`.
+    public init(error: GramRequestError) {
+        switch error {
+        case let .ineligible(reason):
+            self.init(reason: reason)
+        case .notFound, .notPending, .expired, .network, .generic:
+            self.init(kind: .generic, blocksRequest: false, offersSetUsername: false, namesPeer: false)
+        }
+    }
+}
+
+/// What the client can see about a request before asking the server. Each field mirrors one of the server's
+/// rules; the server checks them all again, and the ones the client cannot see (account age, the daily
+/// limit, the payer's privacy setting, the conversation history) only the server.
+public struct WalletGramRequestClientState: Equatable, Sendable {
+    public var accountHasUsername: Bool
+    public var accountIsScamOrFake: Bool
+    public var peerIsScamOrFake: Bool
+    /// The other person charges the account Stars for messages (the account is not exempt).
+    public var peerChargesForMessages: Bool
+
+    public init(accountHasUsername: Bool, accountIsScamOrFake: Bool, peerIsScamOrFake: Bool, peerChargesForMessages: Bool) {
+        self.accountHasUsername = accountHasUsername
+        self.accountIsScamOrFake = accountIsScamOrFake
+        self.peerIsScamOrFake = peerIsScamOrFake
+        self.peerChargesForMessages = peerChargesForMessages
+    }
+
+    /// The first rule the client can see refusing the request, or nil when it sees none.
+    public var refusal: GramRequestIneligibilityReason? {
+        if self.accountIsScamOrFake || self.peerIsScamOrFake {
+            return .restricted
+        }
+        if !self.accountHasUsername {
+            return .usernameRequired
+        }
+        if self.peerChargesForMessages {
+            return .paidMessages
+        }
+        return nil
+    }
+}
+
+/// Whether the Money tab offers Request at all: only while Request GRAM is enabled, and only in a private chat
+/// with a regular user (not a bot, a service account, a deleted account or the account itself). Every other
+/// refusal is explained on the Request tab instead of hiding it.
+public func walletGramRequestIsOffered(isEnabled: Bool, peerIsRegularUser: Bool, peerIsAccount: Bool) -> Bool {
+    return isEnabled && peerIsRegularUser && !peerIsAccount
+}
+
+/// The notice the Request tab shows before anything is sent: what the client sees first, then the server's
+/// eligibility answer (nil while it loads or when it could not be fetched).
+public func walletGramRequestNotice(clientState: WalletGramRequestClientState, eligibility: GramRequestEligibility?) -> WalletGramRequestNotice? {
+    if let refusal = clientState.refusal {
+        return WalletGramRequestNotice(reason: refusal)
+    }
+    if let eligibility, !eligibility.isAllowed {
+        return WalletGramRequestNotice(reason: eligibility.reason ?? .other(""))
+    }
+    return nil
+}
+
+/// The cautions the request sheet shows the payer above the Send button.
+public enum WalletGramRequestWarning: Equatable, Sendable {
+    case usernameRecentlyChanged
+    case noOutgoingMessages
+    case notContact
+}
+
+public func walletGramRequestWarnings(record: GramRequestRecord?, requesterIsContact: Bool) -> [WalletGramRequestWarning] {
+    var result: [WalletGramRequestWarning] = []
+    if record?.usernameRecentlyChanged == true {
+        result.append(.usernameRecentlyChanged)
+    }
+    if record?.noOutgoingMessages == true {
+        result.append(.noOutgoingMessages)
+    }
+    if !requesterIsContact {
+        result.append(.notContact)
+    }
+    return result
+}
+
+/// Why a request in the chat cannot be paid from this device, checked before any signing starts.
+public enum WalletGramRequestPaymentCheck: Equatable, Sendable {
+    case payable
+    /// The server's record says the request is no longer pending, or it has expired.
+    case notPayable
+    /// The address in the message is not the one the server bound to the requester, or the requester's wallet
+    /// address does not match the record. The message must not be trusted for the destination.
+    case addressMismatch
+}
+
+/// Compares the server's record of a request with the message it was shown from and with the requester's
+/// wallet address as the server reports it (`wallet.getUserAddresses`). A payment is built from the record only.
+public func walletGramRequestPaymentCheck(
+    record: GramRequestRecord,
+    messageRequestId: Int64,
+    messageAmount: Int64,
+    messageRequesterAddress: String,
+    requesterWalletAddresses: [String],
+    timestamp: Int32,
+    addressesEqual: (String, String) -> Bool
+) -> WalletGramRequestPaymentCheck {
+    guard record.status.effective(expiresAt: record.expiresAt, timestamp: timestamp).isPending else {
+        return .notPayable
+    }
+    guard record.requestId == messageRequestId, record.amount == messageAmount else {
+        return .addressMismatch
+    }
+    guard addressesEqual(record.requesterAddress, messageRequesterAddress) else {
+        return .addressMismatch
+    }
+    guard requesterWalletAddresses.contains(where: { addressesEqual($0, record.requesterAddress) }) else {
+        return .addressMismatch
+    }
+    return .payable
+}
+
+/// `walletGramRequestPaymentCheck` comparing addresses in their canonical (raw) form, so a bounceable and a
+/// non-bounceable spelling of one address match and nothing else does.
+@available(macOS 10.15, *)
+public func walletGramRequestPaymentCheck(
+    record: GramRequestRecord,
+    messageRequestId: Int64,
+    messageAmount: Int64,
+    messageRequesterAddress: String,
+    requesterWalletAddresses: [String],
+    timestamp: Int32
+) -> WalletGramRequestPaymentCheck {
+    return walletGramRequestPaymentCheck(
+        record: record,
+        messageRequestId: messageRequestId,
+        messageAmount: messageAmount,
+        messageRequesterAddress: messageRequesterAddress,
+        requesterWalletAddresses: requesterWalletAddresses,
+        timestamp: timestamp,
+        addressesEqual: walletEngineAddressesEqual
+    )
+}
+
+/// The id the chat's transfer animation coordinator tracks a Request GRAM gem flight by. A sent transfer's flight is
+/// keyed by its pending operation (`pending:<operation id>`); a request has no wallet operation, so its flight is
+/// keyed by the request message the server created.
+public func walletGramRequestFlightId(_ messageId: EngineMessage.Id) -> String {
+    return "request:\(messageId.peerId.toInt64()):\(messageId.namespace):\(messageId.id)"
+}
+
+/// The request message a `walletGramRequestFlightId` names, or nil for any other id.
+public func walletGramRequestFlightMessageId(_ id: String) -> EngineMessage.Id? {
+    let parts = id.split(separator: ":", omittingEmptySubsequences: false)
+    guard parts.count == 4, parts[0] == "request",
+          let peerId = Int64(parts[1]), let namespace = Int32(parts[2]), let messageId = Int32(parts[3]) else {
+        return nil
+    }
+    return EngineMessage.Id(peerId: EnginePeer.Id(peerId), namespace: namespace, id: messageId)
+}
