@@ -0,0 +1,134 @@
+import Foundation
+import Postbox
+
+/// The state of a Request GRAM message (`messageActionGramRequest`).
+///
+/// The server owns this state: it creates the request as `.pending` and moves it to a terminal state when
+/// the payer pays or declines, the requester cancels, or the request's TTL runs out. The client only folds
+/// the updates it receives into the stored message (`applying(_:)`) and, for display, treats a pending
+/// request whose expiry has passed as expired (`effective(expiresAt:timestamp:)`) so a card never offers a
+/// payment the server will refuse.
+public enum TelegramGramRequestStatus: Equatable, Sendable {
+    case pending
+    case paid(transactionId: String, paidAt: Int32)
+    case declined
+    case cancelled
+    case expired
+
+    public var isPending: Bool {
+        if case .pending = self {
+            return true
+        } else {
+            return false
+        }
+    }
+
+    /// Folds a status that arrived later (an `updateGramRequestStatus`, an edited or refetched message) into
+    /// the stored one.
+    ///
+    /// - A pending request takes whatever arrives.
+    /// - A terminal state is never reopened: nothing turns a request back into `.pending`.
+    /// - `.paid` is final, and replaces any other terminal state that arrived first: a late `.expired`,
+    ///   `.declined` or `.cancelled` never hides a payment that happened.
+    /// - `.expired` gives way to the other terminal states. Expiry races the payment: a payment the server
+    ///   accepted just before the deadline may be reported after the expiry was.
+    /// - Otherwise `.declined` and `.cancelled` keep the first one that arrived.
+    public func applying(_ update: TelegramGramRequestStatus) -> TelegramGramRequestStatus {
+        switch (self, update) {
+        case (.pending, _):
+            return update
+        case (_, .pending):
+            return self
+        case (.paid, _):
+            return self
+        case (.expired, .paid), (.expired, .declined), (.expired, .cancelled):
+            return update
+        case (_, .paid):
+            return update
+        default:
+            return self
+        }
+    }
+
+    /// The status to display at `timestamp` (seconds since 1970).
+    public func effective(expiresAt: Int32, timestamp: Int32) -> TelegramGramRequestStatus {
+        if case .pending = self, expiresAt != 0, timestamp >= expiresAt {
+            return .expired
+        }
+        return self
+    }
+}
+
+extension TelegramGramRequestStatus {
+    private enum Kind: Int32 {
+        case pending = 0
+        case paid = 1
+        case declined = 2
+        case cancelled = 3
+        case expired = 4
+    }
+
+    /// Reads a status stored by `encode(_:prefix:)`. An unknown kind (stored by a newer build) reads as
+    /// `.pending`, which is the state that offers no stale terminal information.
+    init(decoder: PostboxDecoder, prefix: String) {
+        switch Kind(rawValue: decoder.decodeInt32ForKey(prefix + "s", orElse: 0)) ?? .pending {
+        case .pending:
+            self = .pending
+        case .paid:
+            self = .paid(
+                transactionId: decoder.decodeStringForKey(prefix + "tx", orElse: ""),
+                paidAt: decoder.decodeInt32ForKey(prefix + "pa", orElse: 0)
+            )
+        case .declined:
+            self = .declined
+        case .cancelled:
+            self = .cancelled
+        case .expired:
+            self = .expired
+        }
+    }
+
+    func encode(_ encoder: PostboxEncoder, prefix: String) {
+        switch self {
+        case .pending:
+            encoder.encodeInt32(Kind.pending.rawValue, forKey: prefix + "s")
+        case let .paid(transactionId, paidAt):
+            encoder.encodeInt32(Kind.paid.rawValue, forKey: prefix + "s")
+            encoder.encodeString(transactionId, forKey: prefix + "tx")
+            encoder.encodeInt32(paidAt, forKey: prefix + "pa")
+        case .declined:
+            encoder.encodeInt32(Kind.declined.rawValue, forKey: prefix + "s")
+        case .cancelled:
+            encoder.encodeInt32(Kind.cancelled.rawValue, forKey: prefix + "s")
+        case .expired:
+            encoder.encodeInt32(Kind.expired.rawValue, forKey: prefix + "s")
+        }
+    }
+}
+
+/// Applies a status update to the Request GRAM action among a message's media. Returns nil when the message
+/// carries no request, or when the update changes nothing (`TelegramGramRequestStatus.applying(_:)`), so the
+/// caller can skip rewriting the message.
+func gramRequestMediaApplyingStatus(_ media: [Media], status: TelegramGramRequestStatus) -> [Media]? {
+    var didUpdate = false
+    let updatedMedia = media.map { item -> Media in
+        guard let action = item as? TelegramMediaAction,
+              case let .gramRequest(amount, requesterAddress, requestId, expiresAt, comment, currentStatus) = action.action else {
+            return item
+        }
+        let resolvedStatus = currentStatus.applying(status)
+        guard resolvedStatus != currentStatus else {
+            return item
+        }
+        didUpdate = true
+        return TelegramMediaAction(action: .gramRequest(
+            amount: amount,
+            requesterAddress: requesterAddress,
+            requestId: requestId,
+            expiresAt: expiresAt,
+            comment: comment,
+            status: resolvedStatus
+        ))
+    }
+    return didUpdate ? updatedMedia : nil
+}
