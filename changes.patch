+    private func user(_ id: Int64) -> TelegramUser {
+        return TelegramUser(
+            id: PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(id)),
+            accessHash: .personal(id * 10), firstName: "User \(id)", lastName: nil, username: nil, phone: nil, photo: [],
+            botInfo: nil, restrictionInfo: nil, flags: [], emojiStatus: nil, usernames: [],
+            storiesHidden: nil, nameColor: nil, backgroundEmojiId: nil, profileColor: nil,
+            profileBackgroundEmojiId: nil, subscriberCount: nil, verificationIconFileId: nil
+        )
+    }
+
+    private func peers(_ ids: [Int64]) -> [PeerId: SelectivePrivacyPeer] {
+        var result: [PeerId: SelectivePrivacyPeer] = [:]
+        for id in ids {
+            let user = self.user(id)
+            result[user.id] = SelectivePrivacyPeer(peer: user, participantCount: nil)
+        }
+        return result
+    }
+
+    /// What the server returns for the rules the client sent: the same rules, with users as ids.
+    private func storedRules(_ rules: [Api.InputPrivacyRule]) -> [Api.PrivacyRule] {
+        func userIds(_ users: [Api.InputUser]) -> [Int64] {
+            return users.compactMap { user -> Int64? in
+                if case let .inputUser(data) = user {
+                    return data.userId
+                }
+                return nil
+            }
+        }
+        return rules.map { rule -> Api.PrivacyRule in
+            switch rule {
+            case .inputPrivacyValueAllowContacts:
+                return .privacyValueAllowContacts
+            case .inputPrivacyValueAllowAll:
+                return .privacyValueAllowAll
+            case let .inputPrivacyValueAllowUsers(data):
+                return .privacyValueAllowUsers(.init(users: userIds(data.users)))
+            case .inputPrivacyValueDisallowContacts:
+                return .privacyValueDisallowContacts
+            case .inputPrivacyValueDisallowAll:
+                return .privacyValueDisallowAll
+            case let .inputPrivacyValueDisallowUsers(data):
+                return .privacyValueDisallowUsers(.init(users: userIds(data.users)))
+            case let .inputPrivacyValueAllowChatParticipants(data):
+                return .privacyValueAllowChatParticipants(.init(chats: data.chats))
+            case let .inputPrivacyValueDisallowChatParticipants(data):
+                return .privacyValueDisallowChatParticipants(.init(chats: data.chats))
+            case .inputPrivacyValueAllowCloseFriends:
+                return .privacyValueAllowCloseFriends
+            case .inputPrivacyValueAllowPremium:
+                return .privacyValueAllowPremium
+            case .inputPrivacyValueAllowBots:
+                return .privacyValueAllowBots
+            case .inputPrivacyValueDisallowBots:
+                return .privacyValueDisallowBots
+            }
+        }
+    }
+
+    private func encode(_ settings: SelectivePrivacySettings) -> [Api.InputPrivacyRule] {
+        return apiInputPrivacyRules(settings: settings, inputUsers: { peerIds in
+            return peerIds.map { peerId in
+                return Api.InputUser.inputUser(.init(userId: peerId.id._internalGetInt64Value(), accessHash: peerId.id._internalGetInt64Value() * 10))
+            }
+        })
+    }
+
+    private func roundTrip(_ settings: SelectivePrivacySettings, peers: [PeerId: SelectivePrivacyPeer]) -> SelectivePrivacySettings {
+        return SelectivePrivacySettings.gramRequests(apiRules: self.storedRules(self.encode(settings)), peers: peers)
+    }
+
+    private func ruleNames(_ settings: SelectivePrivacySettings) -> [String] {
+        return self.encode(settings).map { "\($0)" }
+    }
+
+    // MARK: - Key
+
+    func test_type_usesTheGramRequestsKey() {
+        XCTAssertEqual("\(UpdateSelectiveAccountPrivacySettingsType.gramRequests.apiKey)", "inputPrivacyKeyGramRequests")
+    }
+
+    // MARK: - The four options
+
+    private let everybody = SelectivePrivacySettings.enableEveryone(disableFor: [:])
+    private let premiumUsers = SelectivePrivacySettings.disableEveryone(enableFor: [:], enableForCloseFriends: false, enableForPremium: true, enableForBots: false)
+    private let myContacts = SelectivePrivacySettings.enableContacts(enableFor: [:], disableFor: [:], enableForPremium: false, enableForBots: false)
+    private let nobody = SelectivePrivacySettings.disableEveryone(enableFor: [:], enableForCloseFriends: false, enableForPremium: false, enableForBots: false)
+
+    func test_options_encodeToTheirRules() {
+        XCTAssertEqual(self.ruleNames(self.everybody), ["inputPrivacyValueAllowAll"])
+        XCTAssertEqual(self.ruleNames(self.premiumUsers), ["inputPrivacyValueDisallowAll", "inputPrivacyValueAllowPremium"])
+        XCTAssertEqual(self.ruleNames(self.myContacts), ["inputPrivacyValueAllowContacts"])
+        XCTAssertEqual(self.ruleNames(self.nobody), ["inputPrivacyValueDisallowAll"])
+    }
+
+    func test_options_roundTrip() {
+        for settings in [self.everybody, self.premiumUsers, self.myContacts, self.nobody] {
+            XCTAssertEqual(self.roundTrip(settings, peers: [:]), settings)
+        }
+    }
+
+    func test_exceptions_roundTrip() {
+        let peers = self.peers([1001, 1002, 1003])
+        let alwaysAllow = self.peers([1001, 1002])
+        let neverAllow = self.peers([1003])
+
+        let premiumWithExceptions = SelectivePrivacySettings.disableEveryone(enableFor: alwaysAllow, enableForCloseFriends: false, enableForPremium: true, enableForBots: false)
+        XCTAssertEqual(self.roundTrip(premiumWithExceptions, peers: peers), premiumWithExceptions)
+
+        let contactsWithExceptions = SelectivePrivacySettings.enableContacts(enableFor: alwaysAllow, disableFor: neverAllow, enableForPremium: false, enableForBots: false)
+        XCTAssertEqual(self.roundTrip(contactsWithExceptions, peers: peers), contactsWithExceptions)
+
+        let everybodyExcept = SelectivePrivacySettings.enableEveryone(disableFor: neverAllow)
+        XCTAssertEqual(self.roundTrip(everybodyExcept, peers: peers), everybodyExcept)
+    }
+
+    func test_exceptionUsers_areSentAsInputUsers() {
+        let settings = SelectivePrivacySettings.enableContacts(enableFor: self.peers([1001]), disableFor: self.peers([1003]), enableForPremium: false, enableForBots: false)
+        XCTAssertEqual(self.ruleNames(settings), ["inputPrivacyValueAllowUsers", "inputPrivacyValueDisallowUsers", "inputPrivacyValueAllowContacts"])
+    }
+
+    // MARK: - Default
+
+    func test_default_isPremiumUsersOnly() {
+        XCTAssertEqual(SelectivePrivacySettings.gramRequestsDefault, self.premiumUsers)
+    }
+
+    func test_noStoredRules_readAsTheDefault() {
+        XCTAssertEqual(SelectivePrivacySettings.gramRequests(apiRules: [], peers: [:]), .gramRequestsDefault)
+        XCTAssertEqual(SelectivePrivacySettings.gramRequests(apiRules: [.privacyValueDisallowAll], peers: [:]), self.nobody, "an explicit Nobody stays Nobody")
+    }
+
+    // MARK: - App config
+
+    func test_configuration_defaults() {
+        XCTAssertEqual(GramRequestConfiguration.with(appConfiguration: .defaultValue), GramRequestConfiguration(isEnabled: false, dailyLimit: 5, minAccountAgeDays: 7, ttlSeconds: 86400))
+    }
+
+    func test_configuration_readsKeys() {
+        let data: JSON = [
+            "gram_requests_enabled": true,
+            "gram_request_daily_limit": 3.0,
+            "gram_request_min_account_age_days": 14.0,
+            "gram_request_ttl_seconds": 3600.0
+        ]
+        let configuration = GramRequestConfiguration.with(appConfiguration: AppConfiguration(data: data, hash: 0))
+        XCTAssertEqual(configuration, GramRequestConfiguration(isEnabled: true, dailyLimit: 3, minAccountAgeDays: 14, ttlSeconds: 3600))
+    }
+
+    func test_configuration_ignoresInvalidLimits() {
+        let data: JSON = [
+            "gram_request_daily_limit": 0.0,
+            "gram_request_ttl_seconds": -5.0
+        ]
+        let configuration = GramRequestConfiguration.with(appConfiguration: AppConfiguration(data: data, hash: 0))
+        XCTAssertEqual(configuration.dailyLimit, 5)
+        XCTAssertEqual(configuration.ttlSeconds, 86400)
+        XCTAssertFalse(configuration.isEnabled)
+    }
+}
diff --git a/submodules/TelegramCore/Tests/GramRequestTests.swift b/submodules/TelegramCore/Tests/GramRequestTests.swift
new file mode 100644
index 000000000..42cf3cf6d
--- /dev/null
+++ b/submodules/TelegramCore/Tests/GramRequestTests.swift
@@ -0,0 +1,231 @@
+import XCTest
+import Postbox
+import TelegramApi
+@testable import TelegramCore
+
+/// Request GRAM model: the status reducer the account state applies to `updateGramRequestStatus`, the
+/// Postbox coding of the two new actions, their Api mapping, and the server error mapping the Request screen
+/// turns into messages.
+final class GramRequestTests: XCTestCase {
+    private let paid = TelegramGramRequestStatus.paid(transactionId: "lt:hash", paidAt: 1_760_000_000)
+    private let otherPaid = TelegramGramRequestStatus.paid(transactionId: "lt:other", paidAt: 1_760_000_100)
+
+    // MARK: - Status reducer
+
+    func test_pending_takesAnyUpdate() {
+        let pending = TelegramGramRequestStatus.pending
+        XCTAssertEqual(pending.applying(self.paid), self.paid)
+        XCTAssertEqual(pending.applying(.declined), .declined)
+        XCTAssertEqual(pending.applying(.cancelled), .cancelled)
+        XCTAssertEqual(pending.applying(.expired), .expired)
+        XCTAssertEqual(pending.applying(.pending), .pending)
+    }
+
+    func test_terminalStates_neverReopen() {
+        for status in [self.paid, .declined, .cancelled, .expired] {
+            XCTAssertEqual(status.applying(.pending), status, "\(status) must not go back to pending")
+        }
+    }
+
+    func test_paid_isFinal() {
+        XCTAssertEqual(self.paid.applying(.expired), self.paid)
+        XCTAssertEqual(self.paid.applying(.declined), self.paid)
+        XCTAssertEqual(self.paid.applying(.cancelled), self.paid)
+        XCTAssertEqual(self.paid.applying(self.otherPaid), self.paid, "the first payment reported stays")
+    }
+
+    func test_paid_replacesOtherTerminalStates() {
+        XCTAssertEqual(TelegramGramRequestStatus.expired.applying(self.paid), self.paid)
+        XCTAssertEqual(TelegramGramRequestStatus.declined.applying(self.paid), self.paid)
+        XCTAssertEqual(TelegramGramRequestStatus.cancelled.applying(self.paid), self.paid)
+    }
+
+    func test_expired_givesWayToServerTerminalStates() {
+        XCTAssertEqual(TelegramGramRequestStatus.expired.applying(.declined), .declined)
+        XCTAssertEqual(TelegramGramRequestStatus.expired.applying(.cancelled), .cancelled)
+    }
+
+    func test_declinedAndCancelled_keepTheFirstArrival() {
+        XCTAssertEqual(TelegramGramRequestStatus.declined.applying(.cancelled), .declined)
+        XCTAssertEqual(TelegramGramRequestStatus.cancelled.applying(.declined), .cancelled)
+        XCTAssertEqual(TelegramGramRequestStatus.declined.applying(.expired), .declined)
+        XCTAssertEqual(TelegramGramRequestStatus.cancelled.applying(.expired), .cancelled)
+    }
+
+    func test_effectiveStatus_expiresPendingOnly() {
+        let expiresAt: Int32 = 1_000
+        XCTAssertEqual(TelegramGramRequestStatus.pending.effective(expiresAt: expiresAt, timestamp: 999), .pending)
+        XCTAssertEqual(TelegramGramRequestStatus.pending.effective(expiresAt: expiresAt, timestamp: 1_000), .expired)
+        XCTAssertEqual(self.paid.effective(expiresAt: expiresAt, timestamp: 5_000), self.paid)
+        XCTAssertEqual(TelegramGramRequestStatus.pending.effective(expiresAt: 0, timestamp: 5_000), .pending, "no expiry recorded")
+    }
+
+    // MARK: - Applying an update to stored media
+
+    private func request(status: TelegramGramRequestStatus, comment: String? = "Logo design — final files") -> TelegramMediaAction {
+        return TelegramMediaAction(action: .gramRequest(
+            amount: 250_000_000_000,
+            requesterAddress: "UQFxFkM_R5Kjp1vRt-1fjORS_6ilI8ihN5KXSc7Tvo_hBKqF",
+            requestId: 77,
+            expiresAt: 1_760_086_400,
+            comment: comment,
+            status: status
+        ))
+    }
+
+    func test_applyingStatusToMedia_rewritesOnlyTheRequest() {
+        let other = TelegramMediaAction(action: .historyCleared)
+        let updated = gramRequestMediaApplyingStatus([other, self.request(status: .pending)], status: self.paid)
+        XCTAssertNotNil(updated)
+        XCTAssertEqual(updated?.count, 2)
+        XCTAssertTrue(updated?[0].isEqual(to: other) == true)
+        XCTAssertTrue(updated?[1].isEqual(to: self.request(status: self.paid)) == true)
+    }
+
+    func test_applyingStatusToMedia_skipsNoOps() {
+        XCTAssertNil(gramRequestMediaApplyingStatus([self.request(status: self.paid)], status: .expired))
+        XCTAssertNil(gramRequestMediaApplyingStatus([self.request(status: .declined)], status: .declined))
+        XCTAssertNil(gramRequestMediaApplyingStatus([TelegramMediaAction(action: .historyCleared)], status: self.paid))
+    }
+
+    // MARK: - Postbox coding
+
+    private func roundTrip(_ action: TelegramMediaActionType) -> TelegramMediaActionType {
+        let encoder = PostboxEncoder()
+        action.encode(encoder)
+        return TelegramMediaActionType(decoder: PostboxDecoder(buffer: MemoryBuffer(data: encoder.makeData())))
+    }
+
+    func test_gramRequest_postboxRoundTrip_everyStatus() {
+        for status in [TelegramGramRequestStatus.pending, self.paid, .declined, .cancelled, .expired] {
+            let action = self.request(status: status).action
+            XCTAssertEqual(self.roundTrip(action), action)
+        }
+        let withoutComment = self.request(status: .pending, comment: nil).action
+        XCTAssertEqual(self.roundTrip(withoutComment), withoutComment)
+    }
+
+    func test_gramRequestPaid_postboxRoundTrip() {
+        let action = TelegramMediaActionType.gramRequestPaid(amount: 250_000_000_000, transactionId: "lt:hash", requestMessageId: 4512)
+        XCTAssertEqual(self.roundTrip(action), action)
+    }
+
+    /// Raw values 70 and 71 must not collide with an existing action: if they did, a stored request would
+    /// decode as some other service message.
+    func test_rawValues_doNotCollideWithTransfer() {
+        let transfer = TelegramMediaActionType.gramTransfer(amount: 1, peerAddress: "a", transactionId: "t", comment: nil, commentEncrypted: false)
+        XCTAssertEqual(self.roundTrip(transfer), transfer)
+        if case .gramRequest = self.roundTrip(self.request(status: .pending).action) {
+        } else {
+            XCTFail("a request must decode as a request")
+        }
+    }
+
+    // MARK: - Api mapping
+
+    func test_apiRequest_mapsEveryField() {
+        let apiAction = Api.MessageAction.messageActionGramRequest(.init(
+            flags: 1 << 0,
+            amount: 250_000_000_000,
+            requesterAddress: "UQFxFkM_R5Kjp1vRt-1fjORS_6ilI8ihN5KXSc7Tvo_hBKqF",
+            requestId: 77,
+            expiresAt: 1_760_086_400,
+            comment: "Logo design — final files",
+            status: .gramRequestStatusPaid(.init(transactionId: "lt:hash", paidAt: 1_760_000_000))
+        ))
+        let mapped = telegramMediaActionFromApiAction(apiAction)
+        XCTAssertEqual(mapped?.action, self.request(status: self.paid).action)
+    }
+
+    func test_apiStatuses_map() {
+        XCTAssertEqual(TelegramGramRequestStatus(apiStatus: .gramRequestStatusPending), .pending)
+        XCTAssertEqual(TelegramGramRequestStatus(apiStatus: .gramRequestStatusDeclined), .declined)
+        XCTAssertEqual(TelegramGramRequestStatus(apiStatus: .gramRequestStatusCancelled), .cancelled)
+        XCTAssertEqual(TelegramGramRequestStatus(apiStatus: .gramRequestStatusExpired), .expired)
+        XCTAssertEqual(TelegramGramRequestStatus(apiStatus: .gramRequestStatusPaid(.init(transactionId: "x", paidAt: 5))), .paid(transactionId: "x", paidAt: 5))
+    }
+
+    func test_apiPaid_maps() {
+        let apiAction = Api.MessageAction.messageActionGramRequestPaid(.init(amount: 5, transactionId: "lt:hash", requestMsgId: 4512))
+        XCTAssertEqual(telegramMediaActionFromApiAction(apiAction)?.action, .gramRequestPaid(amount: 5, transactionId: "lt:hash", requestMessageId: 4512))
+    }
+
+    func test_apiEligibility_maps() {
+        let allowed = GramRequestEligibility(apiEligibility: .gramRequestEligibility(.init(flags: 1 << 0, reason: nil, remainingToday: 4)))
+        XCTAssertEqual(allowed, GramRequestEligibility(isAllowed: true, reason: nil, remainingToday: 4))
+
+        let refused = GramRequestEligibility(apiEligibility: .gramRequestEligibility(.init(flags: 1 << 1, reason: "GRAM_REQUEST_PRIVACY", remainingToday: 0)))
+        XCTAssertEqual(refused, GramRequestEligibility(isAllowed: false, reason: .privacy, remainingToday: 0))
+
+        let refusedWithoutReason = GramRequestEligibility(apiEligibility: .gramRequestEligibility(.init(flags: 0, reason: nil, remainingToday: -3)))
+        XCTAssertEqual(refusedWithoutReason, GramRequestEligibility(isAllowed: false, reason: .other(""), remainingToday: 0))
+    }
+
+    func test_apiRecord_mapsWarningsAndAddress() {
+        let record = GramRequestRecord(apiRequest: .gramRequest(.init(
+            flags: (1 << 0) | (1 << 1),
+            requestId: 77,
+            amount: 250_000_000_000,
+            requesterAddress: "UQFx",
+            expiresAt: 1_760_086_400,
+            status: .gramRequestStatusPending,
+            comment: "Logo"
+        )))
+        XCTAssertEqual(record, GramRequestRecord(requestId: 77, amount: 250_000_000_000, requesterAddress: "UQFx", expiresAt: 1_760_086_400, status: .pending, comment: "Logo", usernameRecentlyChanged: true, noOutgoingMessages: false))
+    }
+
+    // MARK: - Server errors
+
+    func test_ineligibilityReasons_mapFromErrorText() {
+        let expected: [String: GramRequestIneligibilityReason] = [
+            "GRAM_REQUESTS_DISABLED": .featureDisabled,
+            "GRAM_REQUEST_USERNAME_REQUIRED": .usernameRequired,
+            "GRAM_REQUEST_ACCOUNT_TOO_NEW": .accountTooNew,
+            "GRAM_REQUEST_DAILY_LIMIT": .dailyLimit,
+            "GRAM_REQUEST_PENDING_EXISTS": .pendingRequestExists,
+            "GRAM_REQUEST_PRIVACY": .privacy,
+            "GRAM_REQUEST_NO_CONVERSATION": .noConversation,
+            "GRAM_REQUEST_PAID_MESSAGES": .paidMessages,
+            "GRAM_REQUEST_RESTRICTED": .restricted,
+            "GRAM_REQUEST_AMOUNT_INVALID": .amountInvalid
+        ]
+        for (text, reason) in expected {
+            XCTAssertEqual(GramRequestIneligibilityReason(errorText: text), reason, text)
+            XCTAssertEqual(GramRequestError(errorText: text, errorCode: 400), .ineligible(reason), text)
+        }
+        XCTAssertEqual(GramRequestIneligibilityReason(errorText: "GRAM_REQUEST_SOMETHING_NEW"), .other("GRAM_REQUEST_SOMETHING_NEW"))
+    }
+
+    func test_requestErrors_mapFromErrorText() {
+        XCTAssertEqual(GramRequestError(errorText: "GRAM_REQUEST_NOT_FOUND", errorCode: 400), .notFound)
+        XCTAssertEqual(GramRequestError(errorText: "MESSAGE_ID_INVALID", errorCode: 400), .notFound)
+        XCTAssertEqual(GramRequestError(errorText: "GRAM_REQUEST_NOT_PENDING", errorCode: 400), .notPending)
+        XCTAssertEqual(GramRequestError(errorText: "GRAM_REQUEST_EXPIRED", errorCode: 400), .expired)
+        XCTAssertEqual(GramRequestError(errorText: "FLOOD_WAIT_5", errorCode: 420), .generic)
+        XCTAssertEqual(GramRequestError(errorText: "", errorCode: -1), .network)
+        XCTAssertEqual(GramRequestError(errorText: "GRAM_REQUEST_SOMETHING_NEW", errorCode: 400), .ineligible(.other("GRAM_REQUEST_SOMETHING_NEW")))
+    }
+
+    // MARK: - The created request message
+
+    func test_createdMessageId_comesFromTheCallsRandomId() {
+        let peerId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(777))
+        let updates = Api.Updates.updates(.init(
+            updates: [
+                .updateMessageID(.init(id: 4100, randomId: 1)),
+                .updateMessageID(.init(id: 4512, randomId: 99))
+            ],
+            users: [],
+            chats: [],
+            date: 0,
+            seq: 0
+        ))
+        XCTAssertEqual(gramRequestCreatedMessageId(updates: updates, peerId: peerId, randomId: 99), MessageId(peerId: peerId, namespace: Namespaces.Message.Cloud, id: 4512))
+    }
+
+    func test_createdMessageId_isNilWithoutAMessage() {
+        let peerId = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(777))
+        let updates = Api.Updates.updates(.init(updates: [], users: [], chats: [], date: 0, seq: 0))
+        XCTAssertNil(gramRequestCreatedMessageId(updates: updates, peerId: peerId, randomId: 99))
+    }
+}
